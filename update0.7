local potionBusy,potionLast,potionAttempt=false,nil,-math.huge
local potionMessage='Ready'
local function potionDue(count,threshold,last) return type(count)=='number' and count<threshold and (last==nil or count<last) end
local function stepPotion()
    local inv=player:FindFirstChild('Inventory');local count=inv and inv:GetAttribute('white_potion')
    potionDisplay.Text='White Potion: '..tostring(count or '?')..' | '..potionMessage
    if not config.autoPotion then potionLast=nil;return end
    if potionBusy or not potionDue(count,config.potionBelow,potionLast) or os.clock()-potionAttempt<30 then return end
    potionBusy=true;potionAttempt=os.clock()
    local batches=config.potionBatches
    task.spawn(function()
        local bought=0
        local ok,err=pcall(function()
            for i=1,batches do
                if not running or not config.autoPotion then break end
                local result=bounded(bounded(RS,'Remotes'),'Shop'):InvokeServer('buy','white_potion',99)
                if not running then return end
                if type(result)~='table' or not result.ok then potionMessage='Refused: '..tostring(type(result)=='table' and (result.error or result.message) or result);break end
                bought=bought+1;potionMessage=('Purchased %d/%d bottles'):format(bought*99,batches*99)
                task.wait(.4)
            end
        end)
        potionBusy=false
        if not running then return end
        if not ok then potionMessage=tostring(err) end
        potionLast=bought==batches and inv:GetAttribute('white_potion') or nil
    end)
end

