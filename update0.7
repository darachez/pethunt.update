local function copy(t) return Http:JSONDecode(Http:JSONEncode(t)) end
local function validate(t)
    assert(type(t)=='table','Invalid profile')
    local clean=copy(config)
    for _,k in ipairs({'stage','world','chest','skills','returnHome'}) do
        assert(type(t[k])=='boolean','Invalid '..k);clean[k]=t[k]
    end
    assert(type(t.boss)=='string' and #t.boss<=120,'Invalid boss');clean.boss=t.boss
    assert(type(t.prompt)=='string' and #t.prompt<=200,'Invalid prompt');clean.prompt=t.prompt
    assert(type(t.radius)=='number' and t.radius>=10 and t.radius<=5000,'Invalid radius');clean.radius=t.radius
    assert(t.replay==nil or type(t.replay)=='boolean','Invalid replay');clean.replay=t.replay==true
    assert(t.autoKeys==nil or type(t.autoKeys)=='boolean','Invalid autoKeys');clean.autoKeys=t.autoKeys==true
    local qty=t.buyQty or 10;assert(type(qty)=='number' and qty%1==0 and qty>=1 and qty<=100,'Buy quantity must be 1-100');clean.buyQty=qty
    assert(t.respawn==nil or type(t.respawn)=='boolean','Invalid respawn');clean.respawn=t.respawn==true
    for _,k in ipairs({'autoEnter','autoPotion','autoExecute','antiAfk','rejoin20'}) do
        assert(t[k]==nil or type(t[k])=='boolean','Invalid '..k);clean[k]=t[k]==true
    end
    clean.dungeonMode=t.dungeonMode or 'crypt';assert(clean.dungeonMode=='crypt' or clean.dungeonMode=='endless' or clean.dungeonMode=='gold','Invalid dungeon mode')
    clean.difficulty=t.difficulty or 'normal';assert(clean.difficulty=='normal' or clean.difficulty=='hard','Invalid difficulty')
    clean.potionBelow=t.potionBelow or 100;assert(type(clean.potionBelow)=='number' and clean.potionBelow%1==0 and clean.potionBelow>=1 and clean.potionBelow<=100000,'Invalid potion threshold')
    clean.potionBatches=t.potionBatches or 5;assert(type(clean.potionBatches)=='number' and clean.potionBatches%1==0 and clean.potionBatches>=1 and clean.potionBatches<=100,'Invalid potion batches')
    for _,k in ipairs({'field','dungeonCombat'}) do assert(t[k]==nil or type(t[k])=='boolean','Invalid '..k);clean[k]=t[k]==true end
    clean.movement={}
    for _,mode in ipairs({'field','stage','world','dungeon'}) do
        local m=(type(t.movement)=='table' and t.movement[mode]) or {}
        assert(type(m)=='table','Invalid movement')
        local side=m.side or 'Behind';assert(side=='Front' or side=='Below' or side=='Above' or side=='Behind','Invalid position')
        local distance=m.distance or 3;assert(type(distance)=='number' and distance>=0 and distance<=100,'Distance must be 0-100')
        local chosen=m.selected or {};assert(type(chosen)=='table','Invalid monster selection')
        for id,on in pairs(chosen) do assert(type(id)=='string' and type(on)=='boolean','Invalid monster choice') end
        clean.movement[mode]={enabled=m.enabled==true,side=side,distance=distance,selected=copy(chosen)}
    end
    clean.position=false
    if t.position then
        assert(type(t.position)=='table' and t.position.place==game.PlaceId,'Position is for a different place')
        assert(type(t.position.cf)=='table' and #t.position.cf==12,'Invalid position')
        for _,n in ipairs(t.position.cf) do assert(type(n)=='number' and n==n and math.abs(n)<1e8,'Invalid coordinate') end
        clean.position=copy(t.position)
    end
    return clean
end
