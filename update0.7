-- Scoped to keep Lua's active local-variable count below the limit.
do
    local teleport=game:GetService('TeleportService')
    local queued=false
    local rejoinAt=os.clock()+1200
    local pendingAt=nil
    local queueFunction=queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (delta and delta.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    local function queueResume()
        if not config.autoExecute or queued then return end
        assert(type(queueFunction)=='function','Executor has no queue_on_teleport API')
        local source=env.PetHuntSource
        if not source and type(readfile)=='function' then local ok,text=pcall(readfile,'PetHuntParty.lua');if ok then source=text end end
        assert(type(source)=='string' and #source>100,'Place PetHuntParty.lua in executor workspace and run START.lua')
        local saved=Http:JSONEncode(validate(config))
        local bootstrap=("repeat task.wait(.5) until game:IsLoaded() and game:GetService('Players').LocalPlayer; local e=(getgenv and getgenv()) or _G; e.PetHuntResumeConfig=game:GetService('HttpService'):JSONDecode(%q); e.PetHuntSource=%q; local f,err=loadstring(e.PetHuntSource); assert(f,err); f()"):format(saved,source)
        queueFunction(bootstrap);queued=true
    end
    connect(player.OnTeleport,function(state)
        if state==Enum.TeleportState.Started or state==Enum.TeleportState.InProgress then
            local ok,err=pcall(queueResume);if not ok then say('Auto Execute: '..tostring(err)) end
        elseif state==Enum.TeleportState.Failed then queued=false;pendingAt=nil;rejoinAt=os.clock()+30 end
    end)
    connect(teleport.TeleportInitFailed,function(who)
        if who==player then queued=false;pendingAt=nil;rejoinAt=os.clock()+30 end
    end)
    connect(player.Idled,function()
        if not config.antiAfk then return end
        local ok,err=pcall(function() local v=game:GetService('VirtualUser');v:CaptureController();v:ClickButton2(Vector2.new(0,0)) end)
        if not ok then say('Anti AFK unavailable: '..tostring(err)) end
    end)
    sessionStep=function()
        local remaining=math.max(0,math.ceil(rejoinAt-os.clock()))
        sessionDisplay.Text=('Rejoin: %s | Auto Execute: %s'):format(config.rejoin20 and (remaining..'s') or 'Off',config.autoExecute and (type(queueFunction)=='function' and 'Ready (START.lua required)' or 'API unavailable') or 'Off')
        if not config.rejoin20 then rejoinAt=os.clock()+1200;return end
        if pendingAt then
            if os.clock()-pendingAt>30 then pendingAt=nil;queued=false;rejoinAt=os.clock()+30 end
            return
        end
        if os.clock()<rejoinAt then return end
        local ok,err=pcall(function()
            if config.autoExecute then queueResume() end
            pendingAt=os.clock()
            bounded(bounded(RS,'Remotes'),'Rejoin'):FireServer(target.auto==true)
        end)
        if not ok then pendingAt=nil;rejoinAt=os.clock()+30;say('Rejoin: '..tostring(err)) end
    end
end

