        if align then align:Destroy();align=nil end
        if attachment then attachment:Destroy();attachment=nil end
        if humanoid and humanoid.Parent then humanoid.AutoRotate=oldRotate end
        humanoid=nil
    end
    function movementRuntime.hold(r,h,position)
        if not attachment or attachment.Parent~=r then
            movementRuntime.release();humanoid=h;oldRotate=h.AutoRotate;h.AutoRotate=false
            attachment=Instance.new('Attachment');attachment.Name='PetHuntFarmAttachment';attachment.Parent=r
            align=Instance.new('AlignPosition');align.Name='PetHuntFarmPosition';align.Mode=Enum.PositionAlignmentMode.OneAttachment
