                    end
                    local at=RS:GetAttribute('WorldBossAt');local seconds=type(at)=='number' and math.max(0,math.ceil(at-workspace:GetServerTimeNow())) or nil
                    say(seconds and ('Waiting World Boss: '..seconds..'s') or 'Waiting for boss / replicated spawn')
                end
                return
            end
            if isWorld and not wasWorld then returnCF=config.position and CFrame.new(table.unpack(config.position.cf)) or r.CFrame;wasWorld=true end
            movementRuntime.lock=m
            local movement=config.movement[mode]
            if movement and movement.enabled then
                local position=farmPosition(m.PrimaryPart,m,movement)
                if lastTarget~=m or lastMovementMode~=mode then
                    -- R is wired to TargetController.setAuto(not auto) in CombatController.
                    -- Set explicit states to avoid toggling in the wrong direction.
                    target.setAuto(false);movementRuntime.release()
                    task.wait(.05)
                    if not running or not alive(m) then return end
                    r.CFrame=CFrame.lookAt(position,m.PrimaryPart.Position)
                    h:MoveTo(position)
                    target.set(m);target.setAuto(true);target.set(m)
                    lastTarget=m;lastMovementMode=mode;ownsTarget=true
                elseif target.current~=m then target.set(m) end
                movementRuntime.hold(r,h,position)
            else
                movementRuntime.release();movementRuntime.lock=nil;lastMovementMode=nil
                if target.auto then target.setAuto(false) end
                if lastTarget~=m or target.current~=m then target.set(m);lastTarget=m;ownsTarget=true end
                local pos=m.PrimaryPart.Position
                local radiusValue=m:GetAttribute('Radius') or 2
                local delta=r.Position-pos;local flat=Vector3.new(delta.X,0,delta.Z)
                local dir=flat.Magnitude>.01 and flat.Unit or Vector3.new(0,0,1)
                if delta.Magnitude>radiusValue+5 then h:MoveTo(pos+dir*(radiusValue+2)) else h:MoveTo(r.Position) end
            end
            if config.skills then for slot=1,4 do combat.useSkill(slot,true) end end
            say((mode..': ')..tostring(m:GetAttribute('MonsterId') or m.Name)..' | HP '..tostring(m:GetAttribute('Health')))
        end)
        if not ok then releasePrompt();say('Runtime error: '..tostring(e));task.wait(1) end
        task.wait(.25)
    end
end)
