local enterBusy,lastEnter=false,-math.huge
local function stepEnter()
    if not config.autoEnter then enterDisplay.Text='Entry: Off';return end
    if player:GetAttribute('DungeonRun') then enterDisplay.Text='Entry: already inside dungeon';return end
    local r=root();if not r or keyBusy then return end
    if (player:GetAttribute('DownUntil') or 0)>workspace:GetServerTimeNow() then return end
    local mode,diff=entryArgs(config.dungeonMode,config.difficulty)
    if not mode then enterDisplay.Text='Entry: selected mode unavailable';return end
    if enterBusy or os.clock()-lastEnter<10 then return end
    enterBusy=true;lastEnter=os.clock();enterDisplay.Text='Entry: requesting '..mode..' / '..diff
    task.spawn(function()
        local ok,result=pcall(function() return bounded(bounded(RS,'Remotes'),'Dungeon'):InvokeServer('enter',mode,diff) end)
        enterBusy=false
        if not running then return end
        enterDisplay.Text=ok and type(result)=='table' and result.ok and 'Entry accepted / waiting for party or loading' or ('Entry refused: '..tostring(ok and type(result)=='table' and (result.error or result.message) or result))
    end)
end
