local function alive(m) return m and m.Parent and m:IsA('Model') and m.PrimaryPart and (m:GetAttribute('Health') or 0)>0 end
local function eligibleSelection(mode,m)
    local movement=config.movement[mode]
    local chosen=movement and movement.selected or {}
    local any=false;for _,on in pairs(chosen) do if on then any=true;break end end
    return not any or chosen[m:GetAttribute('MonsterId')]==true
end
local function choose(r)
    local folder=workspace:FindFirstChild('Monsters');if not folder then return end
    local candidates={};local inDungeon=player:GetAttribute('DungeonRun')
    local origin=config.position and Vector3.new(table.unpack(config.position.cf,1,3)) or r.Position
    for _,m in ipairs(folder:GetChildren()) do
        if alive(m) then
            local dist=(r.Position-m.PrimaryPart.Position).Magnitude
            local id=m:GetAttribute('MonsterId');local d=defs[id];local mode
            if inDungeon then
                if config.dungeonCombat and dist<=350 then mode='dungeon' end
            elseif m:GetAttribute('WorldBoss') then
                if config.world then mode='world' end
            elseif d and d.role=='boss' and not d.dungeonBoss then
                if config.stage and (config.boss=='Nearest' or id==config.boss) and (origin-m.PrimaryPart.Position).Magnitude<=config.radius then mode='stage' end
            elseif config.field and d and not d.dungeonBoss and (origin-m.PrimaryPart.Position).Magnitude<=config.radius then mode='field' end
            if mode and eligibleSelection(mode,m) then
                local rank=mode=='world' and 0 or mode=='stage' and 1 or 2
                table.insert(candidates,{m=m,mode=mode,rank=rank,dist=dist})
            end
        end
    end
    table.sort(candidates,function(a,b)
        if a.rank~=b.rank then return a.rank<b.rank end
        -- Stay on the current selected monster until it dies.
        if a.m==movementRuntime.lock then return true elseif b.m==movementRuntime.lock then return false end
        return a.dist<b.dist
    end)
    local c=candidates[1];if c then return c.m,c.mode=='world',c.mode end
end
local function farmPosition(part,m,settings)
    local gap=settings.distance
    local radius=m:GetAttribute('Radius') or 2
    local height=(m:GetAttribute('Height') or part.Size.Y)/2
    local direction=part.CFrame.LookVector
    direction=Vector3.new(direction.X,0,direction.Z)
    direction=direction.Magnitude>.01 and direction.Unit or Vector3.new(0,0,-1)
    if settings.side=='Front' then return part.Position+direction*(radius+gap) end
    if settings.side=='Behind' then return part.Position-direction*(radius+gap) end
    return part.Position+Vector3.new(0,(settings.side=='Above' and 1 or -1)*(height+gap),0)
end
local function chestPrompt(r)
    if not config.chest or player:GetAttribute('DungeonChest')~=true or not player:GetAttribute('DungeonRun') then return end
    local best,dist=nil,math.huge
    for _,p in ipairs(workspace:GetDescendants()) do
        if p:IsA('ProximityPrompt') and p.Enabled then
            local text=(p.Name..' '..p.ActionText..' '..p.ObjectText..' '..(p.Parent and p.Parent.Name or '')):lower()
            local match=config.prompt=='Auto' and (text:find('chest',1,true) or text:find('กล่อง',1,true)) or config.prompt~='Auto' and promptKey(p)==config.prompt
            local part=p.Parent
            local pos=part and (part:IsA('Attachment') and part.WorldPosition or part:IsA('BasePart') and part.Position)
            if not pos and part and part:IsA('Model') then pos=part:GetPivot().Position end
            -- Only approach nearby chest prompts while this player's chest phase is active.
            if match and pos and (r.Position-pos).Magnitude<dist and (r.Position-pos).Magnitude<250 then best={prompt=p,pos=pos};dist=(r.Position-pos).Magnitude end
        end
    end
    return best
end
-- Replay is armed only by the server's Dungeon/chestOpen event.
local function newReplayState() return {openedAt=nil,clicked=false,epoch=0} end
local function observeReplay(state,kind,now,enabled)
    if kind=='start' or kind=='loading' or kind=='restart' or kind=='cancel' or kind=='chest' then
        state.openedAt=nil;state.clicked=false;state.epoch=state.epoch+1
    elseif kind=='chestOpen' and enabled and not state.openedAt then
        state.openedAt=now;state.clicked=false
    end
end
local function replayDue(state,now,enabled)
    return enabled and state.openedAt~=nil and not state.clicked and now-state.openedAt>=3
end
local replayState=newReplayState()
local resultContext=nil
local replayButtonSeen=nil
local replayAttempts,lastReplayAttempt,replayBusy=0,-math.huge,false
local remotes=bounded(RS,'Remotes')
local lang=require(bounded(shared,'Lang'))
connect(bounded(remotes,'Effect').OnClientEvent,function(channel,payload)
    if channel=='Dungeon' and type(payload)=='table' then
        observeReplay(replayState,payload.kind,os.clock(),config.replay)
        if payload.kind=='start' or payload.kind=='loading' or payload.kind=='restart' or payload.kind=='chest' or payload.kind=='cancel' then
            resultContext=nil;replayButtonSeen=nil;replayAttempts=0;lastReplayAttempt=-math.huge;replayBusy=false
        elseif payload.kind=='result' and type(payload.dungeon)=='string' and type(payload.diff)=='string' then
            resultContext={dungeon=payload.dungeon,diff=payload.diff}
        elseif payload.kind=='replayState' and table.find(payload.waiting or {},player.UserId) then
            replayState.clicked=true
        end
    end
end)
-- KnockedOut.lua uses Revive:FireServer('respawn'). Do not send
-- when DungeonLives=0: the same button would leave or spectate instead.
local function respawnDecision(enabled,inDungeon,down,hp,lives)
    if not enabled or not inDungeon then return 'idle' end
    local dead=down or (type(hp)=='number' and hp<=0)
    if not dead then return 'alive' end
    if type(lives)~='number' then return 'unknown' end
    if lives<=0 then return 'exhausted' end
    return 'respawn'
end
local lastRespawn=-math.huge
local respawnAttempts=0
local function stepRespawn()
    local character=player.Character
    local humanoid=character and character:FindFirstChildOfClass('Humanoid')
    local untilTime=player:GetAttribute('DownUntil')
    local down=type(untilTime)=='number' and untilTime>workspace:GetServerTimeNow()
    local lives=player:GetAttribute('DungeonLives')
    local decision=respawnDecision(config.respawn,player:GetAttribute('DungeonRun')~=nil and player:GetAttribute('DungeonRun')~=false,down,humanoid and humanoid.Health,lives)
    if decision=='idle' or decision=='alive' then
        respawnAttempts=0;lastRespawn=-math.huge
        respawnDisplay.Text=config.respawn and ('Respawn: Ready | Lives: '..tostring(lives or '?')) or 'Respawn: Off'
        return false
    end
    if decision=='unknown' then respawnDisplay.Text='Respawn: waiting for DungeonLives';return true end
    if decision=='exhausted' then respawnDisplay.Text='Respawn: no lives left; waiting for revive';return true end
    if respawnAttempts>=3 then respawnDisplay.Text='Respawn: unconfirmed after 3 attempts; toggle to retry';return true end
    if os.clock()-lastRespawn<2 then respawnDisplay.Text='Respawn: waiting for server';return true end
    releasePrompt()
    lastRespawn=os.clock();respawnAttempts=respawnAttempts+1
    bounded(remotes,'Revive'):FireServer('respawn')
    respawnDisplay.Text=('Respawn requested | Lives: %s | Try %d/3'):format(tostring(lives),respawnAttempts)
    return true
end

local function visibleControl(control)
    if not control.Active or control.AbsoluteSize.X<=0 or control.AbsoluteSize.Y<=0 then return false end
    local node=control
    while node and node~=player.PlayerGui do
        if node:IsA('GuiObject') and not node.Visible then return false end
        if node:IsA('ScreenGui') and not node.Enabled then return false end
        node=node.Parent
    end
    return node==player.PlayerGui
end
local function normalizeReplayText(text)
    return tostring(text):gsub('<[^>]*>',''):gsub('^%s+',''):gsub('%s+$',''):upper()
end
local function findReplayButton()
    local expected=normalizeReplayText(lang.t('REPLAY'))
    for _,node in ipairs(player.PlayerGui:GetDescendants()) do
        if node:IsA('GuiButton') and not node:IsDescendantOf(gui) and visibleControl(node) then
            local matches=node:IsA('TextButton') and normalizeReplayText(node.Text)==expected
            if not matches then
                for _,child in ipairs(node:GetDescendants()) do
                    if child:IsA('TextLabel') and child.Visible and normalizeReplayText(child.Text)==expected then matches=true;break end
                end
            end
            if matches then return node end
        end
    end
end
local function clickReplay(control)
    if type(firesignal)=='function' then
        firesignal(control.Activated)
    else
        local vim=game:GetService('VirtualInputManager')
        local point=control.AbsolutePosition+control.AbsoluteSize/2
        local screen=control:FindFirstAncestorWhichIsA('ScreenGui')
        if screen and not screen.IgnoreGuiInset then point=point+game:GetService('GuiService'):GetGuiInset() end
        vim:SendMouseButtonEvent(point.X,point.Y,0,true,game,0)
        task.wait(.05)
        vim:SendMouseButtonEvent(point.X,point.Y,0,false,game,0)
    end
end
local function stepReplay()
    if not config.replay then
        replayState.openedAt=nil;replayState.clicked=false
        replayButtonSeen=nil;replayAttempts=0;lastReplayAttempt=-math.huge
        return false
    end
    local control=findReplayButton()
    -- Fallback for a missed chestOpen event: the actual reward popup is evidence
    -- the run ended; start a full 3-second delay on first seeing its Replay button.
    if control and control~=replayButtonSeen then
        replayButtonSeen=control
        if not replayState.openedAt or replayState.clicked then
            replayState.openedAt=os.clock();replayState.clicked=false
            replayAttempts=0;lastReplayAttempt=-math.huge
        end
    end
    if replayState.clicked then return false end
    if not replayState.openedAt then return false end
    if not replayDue(replayState,os.clock(),true) then
        say(('Chest opened. Replay in %.1fs'):format(math.max(0,3-(os.clock()-replayState.openedAt))))
        return true
    end
    if not control then say('Waiting for an enabled Replay button');return true end
    if replayBusy then return true end
    if replayAttempts>=3 then say('Replay not confirmed after 3 attempts. Press manually or toggle Auto Replay to retry.');return true end
    if os.clock()-lastReplayAttempt<2 then return true end
    replayAttempts=replayAttempts+1;lastReplayAttempt=os.clock();replayBusy=true
    local epoch=replayState.epoch
    local context=resultContext
    task.spawn(function()
        local ok,response=pcall(function()
            if context then
                -- Exactly the same request used by DungeonUi's REPLAY OnClick.
                return bounded(remotes,'Dungeon'):InvokeServer('replay',context.dungeon,context.diff)
            end
            clickReplay(control)
            return nil
        end)
        if not running or epoch~=replayState.epoch then return end
        replayBusy=false
        if ok and type(response)=='table' and response.ok then
            replayState.clicked=true
            say(response.waiting and 'Replay confirmed: waiting for party' or 'Replay accepted by server')
        elseif replayState.clicked then
            say('Replay vote confirmed by server')
        elseif ok and not context and (not control.Parent or not control.Active) then
            replayState.clicked=true
            say('Replay button responded; waiting for next dungeon')
        else
            say('Replay not confirmed: '..tostring(ok and (type(response)=='table' and (response.error or response.message) or 'button unchanged') or response))
        end
    end)
    return true
end

local lastTarget,wasWorld,returnCF=nil,false,nil
