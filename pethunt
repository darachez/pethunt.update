local nestedScrollLocks={}
local function setupNestedScroll(parent,child)
    child.Active=true;child.ScrollingEnabled=true
    child.ScrollingDirection=Enum.ScrollingDirection.Y
    child.ScrollBarThickness=7;child.ScrollBarImageColor3=Color3.fromRGB(175,155,220)
