    local function hits(input,control)
        if not control or not control.Parent then return false end
        local raw=Vector2.new(input.Position.X,input.Position.Y)
        local inset=game:GetService('GuiService'):GetGuiInset()
        local function inside(point)
            local pos,size=control.AbsolutePosition,control.AbsoluteSize
            return point.X>=pos.X and point.Y>=pos.Y and point.X<=pos.X+size.X and point.Y<=pos.Y+size.Y
        end
        -- Executors/UI roots can expose positions with or without the top inset.
        if inside(raw) or inside(raw-inset) then return true end
        local ok,objects=pcall(function() return player.PlayerGui:GetGuiObjectsAtPosition(raw.X,raw.Y) end)
        if ok then for _,object in ipairs(objects) do if object==control or object:IsDescendantOf(control) then return true end end end
        return false
    end
    connect(UIS.InputBegan,function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
        local snapshot={}
        for _,d in ipairs(dropdowns) do
            if d.list.Visible then snapshot[d]=hits(input,d.list) or hits(input,d.trigger) end
        end
        presses[input]=snapshot
    end)
    connect(UIS.InputEnded,function(input)
        local snapshot=presses[input];presses[input]=nil
        if not snapshot then return end
        -- Let TextButton.Activated run before outside-click dismissal.
        task.defer(function()
            if not running then return end
            for d,startedInside in pairs(snapshot) do
                if d.list.Visible and not startedInside and not hits(input,d.list) and not hits(input,d.trigger) then d.list.Visible=false end
            end
        end)
    end)
end
