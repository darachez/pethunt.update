local keyBusy,keyLastCount,keyLastAttempt=false,nil,-math.huge
local keyMessage='Ready'
local function keyCount()
    local inv=player:FindFirstChild('Inventory')
    local count=inv and inv:GetAttribute(dungeonsConfig.keyItem)
    if type(count)=='number' then return count end
    return nil
end
local function validQuantity(n)
    return type(n)=='number' and n==n and n%1==0 and n>=1 and n<=100
end
local function shouldBuyKeys(count,previous)
    return count~=nil and count<=5 and (previous==nil or count<previous)
end
local function purchaseKeys(quantity,automatic)
    assert(validQuantity(quantity),'Buy quantity must be 1-100')
    assert(not keyBusy,'A key purchase is already running')
    keyBusy=true;keyLastAttempt=os.clock()
    task.spawn(function()
        local purchased=0
        local ok,err=pcall(function()
            local remote=bounded(bounded(RS,'Remotes'),'Dungeon')
            for i=1,quantity do
                if not running or (automatic and not config.autoKeys) then break end
                local gold=player:GetAttribute('Gold')
                if type(gold)=='number' and gold<(dungeonsConfig.keyPrice or 0) then
                    keyMessage='Not enough Gold';break
                end
                -- The game's Buy key button sends one buyKey request per key.
                local response=remote:InvokeServer('buyKey')
                if not running then return end
                if type(response)~='table' or response.ok~=true then
                    keyMessage='Server refused buyKey: '..tostring(type(response)=='table' and (response.error or response.message or response.reason) or response)
                    break
                end
                purchased=purchased+1
                keyMessage=('Bought %d/%d keys'):format(purchased,quantity)
                task.wait(.35)
            end
        end)
        keyBusy=false
        if not running then return end
        if not ok then keyMessage='Buy error: '..tostring(err) end
        if purchased==quantity then keyMessage=('Purchased %d keys'):format(purchased) end
        -- Do not repeat a batch just because it leaves inventory at <=5.
        -- Re-arm after the next consumed key, or a 30-second retry after failure.
        keyLastCount=purchased==quantity and keyCount() or nil
        say(keyMessage)
    end)
end
