    connect(timeout.FocusLost,guard(function() local n=tonumber(timeout.Text);assert(n and n>=3 and n<=60,'Timeout must be 3-60');config.stuckSeconds=n end))
    table.insert(refreshers,function() timeout.Text=tostring(config.stuckSeconds) end)
    local display=label(farm,'Smart Farming: Off')
    local function safeGap(weapon,monster,leash)
        local maximum=math.max(.5,math.min(weapon-.75,leash-5))
        local minimum=monster+1.5
        return math.min(maximum,minimum),minimum<=maximum
    end
    local function shapeDanger(shape,point,padding)
