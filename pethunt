    new('UIPadding',child,{PaddingLeft=UDim.new(0,3),PaddingRight=UDim.new(0,12),PaddingTop=UDim.new(0,3),PaddingBottom=UDim.new(0,8)})
    local hovering,touching=false,false
    local function update()
        nestedScrollLocks[child]={parent=parent,locked=(hovering or touching) and child.Visible and parent.Visible}
        local locked=false
        for control,entry in pairs(nestedScrollLocks) do if control.Parent and entry.parent==parent and entry.locked then locked=true;break end end
        parent.ScrollingEnabled=not locked
    end
    connect(child.MouseEnter,function() hovering=true;update() end)
    connect(child.MouseLeave,function() hovering=false;update() end)
    connect(child.InputBegan,function(input) if input.UserInputType==Enum.UserInputType.Touch then touching=true;update() end end)
    connect(UIS.InputEnded,function(input) if input.UserInputType==Enum.UserInputType.Touch then touching=false;update() end end)
    connect(parent:GetPropertyChangedSignal('Visible'),function() hovering=false;touching=false;update() end)
end

