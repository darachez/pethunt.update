        if shape.follow then
            local follow=Players:GetPlayerByUserId(shape.follow)
            local char=follow and follow.Character;local r=char and char:FindFirstChild('HumanoidRootPart')
            if r then center=r.Position end
        end
        local delta=point-center;delta=Vector3.new(delta.X,0,delta.Z)
