local chestWalk={prompt=nil,waypoints=nil,index=1,lastPlan=-math.huge,lastMove=-math.huge}
local function chestInReach(distance,maximum)
    return type(maximum)=='number' and maximum>0 and distance<=math.max(0,maximum-.5)
end
local function waypointReached(dx,dy,dz)
    return dx*dx+dz*dz<=2.5*2.5 and math.abs(dy)<=7
end
function chestWalk.cancel()
    if chestWalk.prompt then local r,h=root();if r then h:MoveTo(r.Position) end end
    chestWalk.prompt=nil;chestWalk.waypoints=nil;chestWalk.index=1
end
function chestWalk.step(chest,r,h)
    local prompt=chest.prompt
    if target.auto then target.setAuto(false) end
    if target.current then target.set(nil) end
    local distance=(r.Position-chest.pos).Magnitude
    if chestInReach(distance,prompt.MaxActivationDistance) then chestWalk.cancel();return true end
    if chestWalk.prompt~=prompt then
        chestWalk.cancel();chestWalk.prompt=prompt;chestWalk.lastPlan=-math.huge
    end
    local now=os.clock()
    if not chestWalk.waypoints or now-chestWalk.lastPlan>=3 then
        chestWalk.lastPlan=now
        local offset=r.Position-chest.pos;offset=Vector3.new(offset.X,0,offset.Z)
        local direction=offset.Magnitude>.01 and offset.Unit or Vector3.new(0,0,1)
        local reach=math.max(1,prompt.MaxActivationDistance)
        local goal=chest.pos+direction*math.min(3,reach*.5)
        local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances={player.Character}
        local floor=workspace:Raycast(goal+Vector3.new(0,12,0),Vector3.new(0,-40,0),params)
        if floor and floor.Normal.Y>.5 then goal=floor.Position end
        local path=game:GetService('PathfindingService'):CreatePath({AgentRadius=2,AgentHeight=5,AgentCanJump=true,WaypointSpacing=3})
        local ok=pcall(function() path:ComputeAsync(r.Position,goal) end)
        if not running or not config.chest or not prompt.Parent or h.Health<=0 then chestWalk.cancel();return false end
        chestWalk.waypoints=ok and path.Status==Enum.PathStatus.Success and path:GetWaypoints() or {{Position=goal}}
        chestWalk.index=1;chestWalk.lastMove=-math.huge
    end
    local points=chestWalk.waypoints
    local point=points and points[chestWalk.index]
    while point do
        local delta=r.Position-point.Position
        if not waypointReached(delta.X,delta.Y,delta.Z) then break end
        chestWalk.index=chestWalk.index+1;point=points[chestWalk.index]
    end
    if not point then chestWalk.waypoints=nil;return false end
    if now-chestWalk.lastMove>=.7 then
        if point.Action==Enum.PathWaypointAction.Jump then h.Jump=true end
        h:MoveTo(point.Position);chestWalk.lastMove=now
    end
    say(('Walking to boss chest... %.1f studs'):format(distance))
    return false
end
