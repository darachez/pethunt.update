        if shape.kind=='line' then
            if typeof(shape.dir)~='Vector3' or type(shape.length)~='number' or type(shape.width)~='number' then return false end
            local dir=Vector3.new(shape.dir.X,0,shape.dir.Z)
            if dir.Magnitude<.001 then return false end
            dir=dir.Unit
            local along=delta:Dot(dir)
